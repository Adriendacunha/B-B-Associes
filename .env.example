# ───────────────────────────────────────────────────────────────────────────
# B&B Associés — Espace client de collecte documentaire
# Copier ce fichier en `.env` et renseigner les valeurs. Ne jamais committer `.env`.
# ───────────────────────────────────────────────────────────────────────────

# Base de données PostgreSQL — HÉBERGÉE EN SUISSE (§9 du brief : nLPD/RGPD).
# Exemple Infomaniak / Exoscale (région CH).
#  - DATABASE_URL : connexion d'exécution (URL "poolée" en serverless, ex. Vercel/Neon).
#  - DIRECT_URL   : connexion DIRECTE (non poolée) pour les migrations.
#    Sur un Postgres classique, mettez la même valeur que DATABASE_URL.
#    Sur Vercel Postgres : DIRECT_URL = POSTGRES_URL_NON_POOLING.
DATABASE_URL="postgresql://user:password@localhost:5432/bb_associes?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bb_associes?schema=public"

# ─── Microsoft Graph (OneDrive Business + envoi e-mail sendMail) — §5, §6.2 ───
# App registration Azure AD du tenant Microsoft 365 du cabinet.
# À CONFIRMER avec le cabinet : nom de domaine du tenant et site/compte cible (§14.1).
# Guide pas-à-pas : voir docs/EMAIL_SETUP.md
#
# RELANCES E-MAIL (bêta) : il suffit de TENANT_ID + CLIENT_ID + CLIENT_SECRET +
# SENDER_ADDRESS pour que les e-mails partent réellement. DRIVE_ID n'est requis
# QUE pour le dépôt OneDrive des pièces validées (peut rester vide pour un bêta).
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
# Boîte d'envoi (boîte partagée recommandée, §6.2). Permission Graph : Mail.Send.
MS_GRAPH_SENDER_ADDRESS="fiscal@bbassocies.ch"
# Drive cible OneDrive Business / SharePoint (ex. "{drive-id}"). Optionnel pour l'e-mail.
MS_GRAPH_DRIVE_ID=""

# ─── SMTP (alternative simple pour TESTER les relances) — Gmail / Google Workspace ───
# Voie la plus rapide pour recevoir réellement les e-mails sans app Azure. Graph reste
# prioritaire s'il est configuré ; sinon SMTP est utilisé ; sinon mode démo.
# Gmail/Workspace : activer la validation en 2 étapes puis créer un « mot de passe
# d'application » (https://myaccount.google.com/apppasswords) — PAS le mot de passe du compte.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"                 # 465 = SSL ; 587 = STARTTLS
# SMTP_USER="vous@votredomaine.ch"
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"   # mot de passe d'application (16 car.)
# SMTP_FROM="B&B Associés <vous@votredomaine.ch>"   # défaut : SMTP_USER
# SMTP_SECURE="true"              # optionnel ; déduit du port sinon

# ─── OCR / extraction de texte (§7.2) ───
# Les PDF numériques sont lus sans réseau ; l'OCR (images / PDF scannés) utilise
# Tesseract via les données de langue locales `tessdata/`. En prod (§9), héberger
# Tesseract en Suisse (ces fichiers ou un binaire système).
# OCR_TESSDATA_PATH=""   # défaut : ./tessdata
# OCR_LANGS="fra+eng"
# OCR_DISABLED="0"        # "1" pour désactiver l'OCR (extraction PDF/texte seule)
# OCR_ENABLED="1"         # sur Vercel, l'OCR est désactivé par défaut (workers
#                         # serverless instables) ; "1" pour le forcer.

# ─── IA de vérification — API Claude (§7.2) ───
# IMPORTANT : Zero Data Retention requis (données fiscales sensibles, §9).
ANTHROPIC_API_KEY=""
# Modèle de vérification documentaire.
ANTHROPIC_VERIFICATION_MODEL="claude-opus-4-8"

# ─── Stockage objet temporaire (avant validation) — chiffré, en Suisse (§5, §12) ───
# S3-compatible (Exoscale SOS / Infomaniak). Les fichiers y restent jusqu'à
# validation humaine puis sont déposés sur OneDrive et purgés.
S3_ENDPOINT=""
S3_REGION="ch-gva-2"
S3_BUCKET="bb-associes-temp"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Chiffrement AU REPOS des fichiers temporaires (§9). Clé hex 64 caractères
# (32 octets) OU passphrase (dérivée par scrypt). Indispensable en production.
#   openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=""

# Conservation / purge (§9, §14.3) : suppression de la copie temporaire des pièces
# finalisées au-delà de ce délai (en jours). Défaut 180.
RETENTION_DAYS="180"

# ─── Auth / sessions ───
AUTH_SECRET="change-me-en-production"
# ⚠️ IMPORTANT pour le bêta : mettre l'URL PUBLIQUE réelle du déploiement (sans
# slash final). C'est la base des liens d'activation / d'espace envoyés par e-mail.
# Si laissé sur localhost, les liens reçus par le bêta-testeur seront cassés.
#   ex. https://b-b-associes-rkke.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mots de passe des comptes cabinet (admin / collaborateur). À DÉFINIR en production :
# le dépôt étant public, les défauts du seed sont connus de tous. Le seed met à jour
# ces comptes à chaque redéploiement si ces variables changent.
ADMIN_PASSWORD=""
COLLAB_PASSWORD=""

# Secret des crons (relances §6.1, purge §9). Vercel ajoute "Authorization: Bearer
# <CRON_SECRET>" aux requêtes des crons déclarés dans vercel.json. En self-hosting,
# l'inclure dans l'appel cron système. Indispensable en production.
CRON_SECRET="change-me-en-production"

# ─── Déploiement auto-hébergé Suisse (docker-compose.yml) ───
POSTGRES_USER="bb"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="bb_associes"
PUBLIC_DOMAIN="collecte.bbassocies.ch"

# Seuil de fiabilité IA pour bascule d'une pièce en `auto_autorise` (§15.4).
AI_AUTO_RELIABILITY_THRESHOLD="0.90"
