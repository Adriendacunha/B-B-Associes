# ───────────────────────────────────────────────────────────────────────────
# B&B Associés — Espace client de collecte documentaire
# Copier ce fichier en `.env` et renseigner les valeurs. Ne jamais committer `.env`.
# ───────────────────────────────────────────────────────────────────────────

# Base de données PostgreSQL — HÉBERGÉE EN SUISSE (§9 du brief : nLPD/RGPD).
# Exemple Infomaniak / Exoscale (région CH).
DATABASE_URL="postgresql://user:password@localhost:5432/bb_associes?schema=public"

# ─── Microsoft Graph (OneDrive Business + envoi e-mail sendMail) — §5, §6.2 ───
# App registration Azure AD du tenant Microsoft 365 du cabinet.
# À CONFIRMER avec le cabinet : nom de domaine du tenant et site/compte cible (§14.1).
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
# Drive cible OneDrive Business / SharePoint (ex. "drives/{drive-id}" ou site/drive).
MS_GRAPH_DRIVE_ID=""
# Boîte d'envoi (boîte partagée recommandée, §6.2).
MS_GRAPH_SENDER_ADDRESS="fiscal@bbassocies.ch"

# ─── IA de vérification — API Claude (§7.2) ───
# IMPORTANT : Zero Data Retention requis (données fiscales sensibles, §9).
ANTHROPIC_API_KEY=""
# Modèle de vérification documentaire.
ANTHROPIC_VERIFICATION_MODEL="claude-opus-4-8"

# ─── Stockage objet temporaire (avant validation) — chiffré, en Suisse (§5, §12) ───
# S3-compatible (Exoscale SOS / Infomaniak). Les fichiers y restent jusqu'à
# validation humaine puis sont déposés sur OneDrive et purgés.
S3_ENDPOINT=""
S3_REGION="ch-gva-2"
S3_BUCKET="bb-associes-temp"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─── Auth / sessions ───
AUTH_SECRET="change-me-en-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seuil de fiabilité IA pour bascule d'une pièce en `auto_autorise` (§15.4).
AI_AUTO_RELIABILITY_THRESHOLD="0.90"
